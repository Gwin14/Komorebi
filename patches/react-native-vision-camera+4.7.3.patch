+    let sourceWidth = CVPixelBufferGetWidth(sourcePixelBuffer)
+    let sourceHeight = CVPixelBufferGetHeight(sourcePixelBuffer)
+    let maxDimension = 1024.0
+    let scale = min(1, maxDimension / Double(max(sourceWidth, sourceHeight)))
+    let targetWidth = max(1, Int((Double(sourceWidth) * scale).rounded()))
