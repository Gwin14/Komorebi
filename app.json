{
  "expo": {
    "name": "Komorebi",
    "platforms": ["ios", "android"],
    "slug": "Komorebi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icons/KomorebiLogo-iOS-Default-1024@1x.png",
    "scheme": "camera",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "br.dev.fabiosantos.komorebi.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "LSRequiresIPhoneOS": true,
        "UIRequiredDeviceCapabilities": ["camera"],
        "NSCameraUsageDescription": "Precisamos da câmera para tirar fotos."
      },
      "appleTeamId": "ZHVJ9S93V4",
      "icon": {
        "light": "./assets/images/app-icons/KomorebiLogo-iOS-Default-1024@1x.png",
        "dark": "./assets/images/app-icons/KomorebiLogo-iOS-Dark-1024@1x.png",
        "tinted": "./assets/images/app-icons/KomorebiLogo-iOS-TintedDark-1024@1x.png"
      }
    },
    "android": {
      "minSdkVersion": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icons/KomorebiLogo-iOS-Default-1024@1x.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "package": "br.dev.fabiosantos.komorebi",
      "icon": "./assets/images/app-icons/KomorebiLogo-iOS-Default-1024@1x.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withCameraStartupSplash",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      ["react-native-vision-camera"],
      [
        "expo-camera",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir que o Komorebi acesse suas fotos.",
          "savePhotosPermission": "Permitir que o Komorebi salve fotos.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo", "video"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o app acesse sua localização para adicionar GPS às fotos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      "expo-web-browser",
      "./plugins/withIosDeploymentTarget",
      "./plugins/withLockedCameraCapture",
      "./plugins/withUiSceneManifest",
      [
        "@sentry/react-native",
        {
          "organization": "fabio-company",
          "project": "komorebi"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f037b9c6-aec0-4cfb-bcac-c33532852726"
      }
    }
  }
}
